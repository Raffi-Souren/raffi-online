{
  "$schema": "radio",
  "$comment": "Six stations. Nothing is sampled — engine/audio.js synthesises each station from the patterns below, so the whole soundtrack costs zero payload. Drop real files into `stems` and they take precedence over synthesis. `bpm` drives the world clock: streetlight flicker, crosswalk signals, club lighting and pedestrian walk cycles all quantise to whatever is playing. `grade` overrides the world colour grade while the station is on.",

  "clock": {
    "$comment": "One transport for the whole game. Everything visual that pulses subscribes to this.",
    "subdivision": 4,
    "swing": 0.0,
    "lookaheadMs": 120,
    "scheduleAheadSec": 0.22,
    "subscribers": ["streetlight-flicker", "crosswalk-signal", "club-lighting", "ped-walk-cycle", "neon-flicker", "hud-pulse"]
  },

  "mix": {
    "masterGain": 0.55,
    "duckUnderDialogue": 0.28,
    "duckAttack": 0.08,
    "duckRelease": 0.5,
    "crossfadeSeconds": 0.9,
    "engineBusGain": 0.5,
    "sfxBusGain": 0.7,
    "inVehicleBoost": 1.25,
    "outOfVehicleMuffle": { "type": "lowpass", "hz": 900, "q": 0.7 }
  },

