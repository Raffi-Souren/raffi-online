    "wheel": { "segments": 8, "color": "#1A1A1E", "hubColor": "#8A8E92", "hubFraction": 0.45 },
    "glass": { "color": "#7FA8C4", "alpha": 0.55, "emissiveNight": 0.05 },
    "lights": {
      "headColor": "#FFF6DA",
      "tailColor": "#FF3A2E",
      "brakeColor": "#FF1A0E",
      "reverseColor": "#FFF0E0",
      "indicatorColor": "#FFA824"
    },
    "blobShadow": { "scale": 1.15, "opacity": 0.38 },
    "damage": { "mode": "cosmetic", "maxDentDepth": 0.12, "paintScuffAt": 0.6 }
  },

