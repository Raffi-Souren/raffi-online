  "$trafficComment": "Ambient traffic budget. Cars are pooled and recycled; none exist outside the streamed districts.",
  "traffic": {
    "maxActive": 18,
    "mobileMaxActive": 10,
    "spawnRadius": 150,
    "despawnRadius": 230,
    "minGap": 14,
    "cruiseSpeedFraction": 0.55,
    "stopAtSignals": true,
    "districtMultiplier": { "heights": 0.7, "downtown": 1.2, "strip": 1.0, "yards": 0.4, "bowl": 0.5 }
  },

  "$parkedComment": "Static parked cars use the same generator with handling disabled, and are baked into one instanced batch per district.",
  "parked": { "maxPerDistrict": 60, "mobileMaxPerDistrict": 34, "curbOffset": 2.4 },

  "player": {
    "enterRadius": 3.0,
    "exitOffset": 1.6,
    "cameraZoom": "vehicle",
