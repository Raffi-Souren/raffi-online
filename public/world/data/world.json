  "$roadComment": "Arterials are a sparse grid; roads.js builds the node/edge graph from `xs` × `zs`, drops any node in `suppressNodes` or inside a landmark keepout, then adds `extraEdges`. Sidewalks, curbs, lane paint and crosswalks are all generated from this.",
  "roadGraph": {
    "arterials": {
      "xs": [-560, -400, -260, -100, 60, 220, 380, 540],
      "zs": [-380, -250, -120, 20, 160, 300]
    },
    "laneWidth": 5.2,
    "defaultLanes": 2,
    "sidewalkWidth": 4.0,
    "curbHeight": 0.22,
    "suppressNodes": ["-400|160", "-400|300", "540|-380", "380|-380", "540|-250", "380|-250"],
    "wideEdges": [
      { "a": "-100|-380", "b": "60|-380", "lanes": 3 },
      { "a": "60|-380", "b": "220|-380", "lanes": 3 },
      { "a": "-100|20", "b": "60|20", "lanes": 3 },
      { "a": "60|20", "b": "220|20", "lanes": 3 }
    ],
    "extraEdges": [
      { "a": "-260|-120", "b": "-100|-120", "lanes": 2, "name": "HARBOR ST" },
      { "a": "220|160", "b": "380|160", "lanes": 2, "name": "YARD GATE RD" },
      { "a": "-260|20", "b": "-260|160", "lanes": 2, "name": "BOWL LOOP" },
      { "a": "380|20", "b": "540|20", "lanes": 2, "name": "PIER RD" }
    ],
    "streetNames": {
      "xs": ["9TH AVE", "7TH AVE", "5TH AVE", "3RD AVE", "VANTAGE AVE", "2ND AVE", "DOCK AVE", "PIER AVE"],
      "zs": ["PROMENADE ST", "BLUFF ST", "HARBOR ST", "CENTRE ST", "LOW ST", "STADIUM ST"]
    }
  },

