          { "x": 220, "z": -300 },
          { "x": 560, "z": 140 },
          { "x": 220, "z": 300 },
          { "x": -400, "z": 300 },
          { "x": -420, "z": -395 }
        ] },
        { "kind": "evade", "startCompliance": 5 }
      ],
      "reward": { "unlocks": [], "line": "m-blackout-win", "endCard": true }
    }
  ],

  "$pickupComment": "Shared pickup visual/behaviour for `collect` objectives.",
  "pickups": {
    "record": { "prop": "record-crate", "spin": 1.6, "bob": 0.25, "radius": 2.2, "glow": "#FFE347" }
  },

  "$hudComment": "Objective text is generated from the objective kind; these are the templates.",
  "templates": {
    "goto": "GET TO THE MARKER",
    "goto-vehicle": "DRIVE TO THE MARKER ({done}/{total})",
    "collect": "RECOVER RECORDS ({done}/{total})",
    "timer": "TIME {mmss}",
    "rhythm": "STAY ON THE GRID ({bars} BARS)",
    "avoid": "DO NOT TRIP A SENSOR",
    "escort": "DELIVER YOUR PASSENGER",
    "evade": "LOSE THEM"
  }
}
