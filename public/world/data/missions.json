{
  "$schema": "missions",
  "$comment": "Eight missions, two to four minutes each. game/missions.js is a small state machine: a mission is a list of objectives, each with a trigger and a completion test. Adding a mission needs no new code unless it uses a `custom` objective kind.",

  "objectiveKinds": {
    "goto": "Reach a world position within `radius`.",
    "goto-vehicle": "Reach a position while driving.",
    "collect": "Pick up N tagged pickups, order-independent.",
    "timer": "Survive/finish before `seconds` elapse.",
    "rhythm": "Hit inputs on the radio clock's beat grid.",
    "avoid": "Do not enter tagged trigger volumes.",
    "escort": "Keep a passenger aboard under a constraint.",
    "evade": "Reduce COMPLIANCE to zero.",
    "custom": "Handled by a named handler in game/missions.js."
  },

  "missions": [
    {
      "id": "deal-clock",
      "name": "DEAL CLOCK",
      "district": "downtown",
      "unlockedBy": null,
      "marker": { "x": 60, "z": -250 },
      "startLine": "m-deal-clock-start",
      "grade": "haze",
      "station": "TLKR",
      "targetSeconds": 165,
      "startVehicle": { "archetype": "compact", "at": { "x": 72, "z": -258 }, "yaw": 1.5708 },
      "objectives": [
        { "kind": "timer", "seconds": 165, "failLine": "m-deal-clock-fail" },
        {
          "kind": "goto-vehicle",
          "repeat": 4,
          "radius": 7,
          "onEach": { "line": "m-deal-clock-stop", "complianceDelta": 1 },
          "points": [
            { "x": -100, "z": -250 },
            { "x": 220, "z": -300 },
            { "x": 60, "z": -380 },
            { "x": -40, "z": -120 }
          ]
        }
      ],
      "reward": { "unlocks": ["crate-dig"], "cash": 0, "line": "m-deal-clock-win" }
