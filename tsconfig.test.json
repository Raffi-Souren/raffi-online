{
  // Pure simulations and data contracts run with TypeScript and Node's test runner.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "incremental": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "outDir": ".test-build",
    "rootDir": ".",
    "types": ["node"],
    "plugins": []
  },
  "include": [
    "lib/*engine.ts",
    "lib/*engine.test.ts",
    "lib/kart-race.ts",
    "lib/kart-race.test.ts",
    "lib/brawl-game.ts",
    "lib/brawl-game.test.ts",
    "lib/signal-lost.ts",
    "lib/signal-lost.test.ts",
    "lib/game-utils.test.ts",
    "lib/scoreboards.test.ts",
    "lib/raf-os.ts",
    "lib/raf-os-fixtures.ts",
    "lib/raf-os.test.ts",
    "lib/raf-os-canonical.ts",
    "lib/raf-os-canonical.test.ts",
    "lib/raf-os-server.ts",
    "lib/raf-os-server.test.ts",
    "data/audio-library.ts",
    "data/crates-tracks.ts"
  ]
}
